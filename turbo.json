{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DATABASE_URL",
		"DATABASE_URL_UNPOOLED",
		"POSTGRES_URL",
		"POSTGRES_URL_NON_POOLING",
		"POSTGRES_URL_NO_SSL",
		"POSTGRES_PRISMA_URL",
		"POSTGRES_HOST",
		"POSTGRES_USER",
		"POSTGRES_PASSWORD",
		"POSTGRES_DATABASE",
		"PGHOST",
		"PGHOST_UNPOOLED",
		"PGUSER",
		"PGPASSWORD",
		"PGDATABASE",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CORS_ORIGIN",
		"NEON_PROJECT_ID",
		"NEXT_PUBLIC_FIREBASE_API_KEY",
		"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN",
		"NEXT_PUBLIC_FIREBASE_PROJECT_ID",
		"NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
		"NEXT_PUBLIC_FIREBASE_APP_ID",
		"NEXT_PUBLIC_FIREBASE_VAPID_KEY",
		"NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID",
		"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET",
		"FIREBASE_SERVER_KEY",
		"FIREBASE_PROJECT_ID",
		"FIREBASE_CLIENT_EMAIL",
		"FIREBASE_PRIVATE_KEY",
		"PING_BEARER_TOKEN",
		"PING_SIGNING_SECRET",
		"NEXT_PUBLIC_POSTHOG_KEY",
		"NEXT_PUBLIC_POSTHOG_HOST",
		"RESEND_API_KEY",
		"GOOGLE_ANDROID_CLIENT_ID",
		"GOOGLE_ANDROID_WEB_ID",
		"GOOGLE_CLIENT_SECRET"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"persistent": true
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:migrate": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false,
			"persistent": true
		}
	}
}
